{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.insta/observe/hook.js\" ] || node \"$CLAUDE_PROJECT_DIR/.insta/observe/hook.js\"",
            "timeout": 15,
            "_insta": "insta-observe"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/NGUYEN HONG SON/.local/bin/graphify.EXE\" hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/NGUYEN HONG SON/.local/bin/graphify.EXE\" hook-guard read"
          }
        ]
      }
    ]
  }
}