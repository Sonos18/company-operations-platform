# Copy this file to .env.local for local development only.
NUXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Taskovia application database
# Supabase Cloud DEV: Project Settings > API
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never rename this with a NUXT_PUBLIC_ prefix.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Domain mailbox that sends employee invitations. Server only; never NUXT_PUBLIC_.
# Leave host/user/pass/from empty to keep the manual copy-and-send flow.
# Zoho: smtp.zoho.com (smtppro.zoho.com for org mailboxes); Hostinger: smtp.hostinger.com; cPanel: mail.<domain>
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
